# MongoDB Atlas or local MongoDB connection
MONGODB_URI=mongodb://localhost:27017/glowguide

# Replace with a random secret of at least 32 bytes before deployment
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optional first admin account. Create one explicitly; no default admin password is shipped.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Google OAuth credentials from Google Cloud Console. Add the callback below
# as an Authorized redirect URI in the OAuth client; then set OAUTH2_ENABLED=true
# and activate SPRING_PROFILES_ACTIVE=dev,oauth. Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
OAUTH2_ENABLED=false
# After credentials are set, enable VITE_GOOGLE_LOGIN_ENABLED=true in frontend/.env.

# SMTP account for verification, password-reset, and contact email.
# For Gmail, use a Google App Password (not the normal account password).
# Set MAIL_FROM to the verified sender address, usually the same as MAIL_USERNAME.
# Contact messages go to CONTACT_TO_EMAIL (defaults to MAIL_USERNAME).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CONTACT_TO_EMAIL=

# Cloudinary image uploads (optional; image URL fields remain available without it)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ENABLED=true
LOG_LEVEL=INFO

# Future AI provider configuration stays on the backend; the current assistant uses the local library/recommendation service.
AI_PROVIDER=none
AI_API_KEY=
AI_ASSISTANT_ENABLED=false
